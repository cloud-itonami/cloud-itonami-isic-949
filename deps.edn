{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.10.914"}
        ;; デジタル庁デザインシステム(DADS) -- the workspace BASE design system
        ;; (com-junkawasaki/root CLAUDE.md, ADR-2607141915). Pinned by :git/sha
        ;; rather than :local/root so this repo stays forkable outside the
        ;; monorepo checkout. Supplies `jp-go-dds.skin/dds+skin`, the vendored
        ;; upstream CSS + skin that `docs/samples/operator-console.html` and the
        ;; already-shipped `docs/index.html` both render against, so the two
        ;; pages share one visual language.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; Sibling cloud-itonami repos invoke build-time generators as
  ;; `clojure -M:dev:render-html`, where :dev pins their `:local/root`
  ;; monorepo deps (e.g. isic-9522 overrides langchain). THIS repo has no
  ;; :local/root deps to override -- its actor pipeline is self-contained
  ;; `civicmembershiporg.operation`, not a langgraph StateGraph -- so :dev is
  ;; deliberately empty and exists only so the shared invocation shape works
  ;; here too. Do not point it at a local jp-go-dds checkout: that would let
  ;; the committed console's CSS drift from the :git/sha pinned above.
  :dev {}
  ;; clojure -M:dev:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by driving the REAL
  ;;      actor (flagship checklist item 2). Throws if the run produced zero
  ;;      HARD governor holds -- see `civicmembershiporg.render-html`.
  :render-html {:main-opts ["-m" "civicmembershiporg.render-html"]}
  ;; :extra-paths alone made this alias uninvocable -- nothing ran the suite,
  ;; which is why 11 misplaced docstrings survived here. `clojure -M:test` now
  ;; runs it; `nbb --classpath src:test run-tests.cljs` runs the same suite
  ;; under the preferred runtime.
  :test {:extra-paths ["test"]
         :main-opts ["-m" "civicmembershiporg.test"]}
  ;; clj-kondo from deps (no binary), errors fail CI. This repo had NO :lint
  ;; alias at all, so nothing ever reported the docstrings.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
